{
  "name": "Phase 12 - Weekly Forecast Update",
  "description": "Update weekly forecasts every Monday at 9 AM",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 * * 1",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "phase_12_weekly_forecast_update",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "predictiveAnalyticsEngine",
            "args": {
              "action": "forecast_daily_profit"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "predictiveAnalyticsEngine"
  }
}