{
  "name": "KYC Approval \u2192 Wallet Sync",
  "description": "Automatically creates financial account and payout credentials when KYC is approved. Initializes wallet and sends activation notification.",
  "trigger": {
    "condition": "${ ((.trigger.data.status == \"approved\") and (.trigger.changed_fields | index(\"status\") != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "KYCVerification"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "kyc_approval_wallet_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "kycApprovalWalletSync",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "kycApprovalWalletSync"
  }
}