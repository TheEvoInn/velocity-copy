{
  "name": "Analytics Aggregation (Every 15 Min)",
  "description": "Cross-module profitability analytics aggregation and reporting",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/15 * * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "analytics_aggregation_every_15_min",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "profitabilityAnalyticsEngine",
            "args": {
              "period": "today",
              "include_modules": [
                "autopilot",
                "discovery",
                "vipz",
                "ned"
              ]
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "profitabilityAnalyticsEngine"
  }
}