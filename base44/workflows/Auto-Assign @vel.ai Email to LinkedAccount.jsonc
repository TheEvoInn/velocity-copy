{
  "name": "Auto-Assign @vel.ai Email to LinkedAccount",
  "description": "Automatically assigns a unique @vel.ai email address to every new LinkedAccount for Autopilot email verification parsing",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "LinkedAccount"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_assign_vel_ai_email_to_linkedaccount",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "linkedAccountEmailAssigner",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "linkedAccountEmailAssigner"
  }
}