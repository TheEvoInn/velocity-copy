{
  "name": "Phase 10 - Queue Optimization",
  "description": "Optimize task queue for maximum profitability every 30 minutes",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 30,
      "interval_unit": "minutes",
      "interval_anchor": "2026-03-23T06:44:12.351000",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "phase_10_queue_optimization",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "profitOptimizer",
            "args": {
              "action": "optimize_batch_plan"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
