{
  "name": "Credential Health Monitoring",
  "description": "Checks credential expiration, disables expired creds, identifies auth failures and rotation needs",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 60,
      "interval_unit": "minutes",
      "interval_anchor": "2026-03-25T05:31:53.752000",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "credential_health_monitoring",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autonomousOperationsOptimizer",
            "args": {
              "action": "credential_health_check"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "autonomousOperationsOptimizer"
  }
}