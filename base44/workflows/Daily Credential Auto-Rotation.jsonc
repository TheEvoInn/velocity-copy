{
  "name": "Daily Credential Auto-Rotation",
  "description": "Checks all verified APIs every 6 hours for health status, response time, and reliability. Writes metrics to SystemMetrics entity (fixed RLS).",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_credential_auto_rotation",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "apiHealthMonitoringSchedulerFixed",
            "args": {
              "action": "check_and_rotate_all"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "apiHealthMonitoringSchedulerFixed"
  }
}