{
  "name": "Tier 5: Multi-Identity Load Balancing (Every 20 Minutes)",
  "description": "Detect identity imbalances and redistribute load. Prevents single-identity burnout and account throttling.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 20,
      "interval_unit": "minutes",
      "interval_anchor": "2026-03-25T07:36:20.455000",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "tier_5_multi_identity_load_balancing_every_20_minutes",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "multiIdentityCoordinator",
            "args": {
              "action": "balance_load_across_identities"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "multiIdentityCoordinator"
  }
}